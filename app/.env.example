# Assistente de IA do Scua Logon — modelo de configuração.
#
# Copie este arquivo para ".env.local" (que o git ignora) e preencha lá.
# NUNCA coloque a chave neste arquivo, e nunca use o prefixo VITE_ nestas variáveis:
# sem o prefixo, o Vite não as envia para o navegador.
#
# Sem chave, o assistente funciona em modo demonstração (respostas simuladas).
# Detalhes: docs/contrato-assistente.md

# Provedor de IA: anthropic (padrão), openai ou gemini.
SCUA_IA_PROVEDOR=

# Chave de API do provedor. Preencha só no .env.local.
SCUA_IA_CHAVE=

# Modelo das conversas e do preenchimento de formulários.
# Vazio com o provedor anthropic usa o modelo padrão; para openai e gemini é obrigatório.
SCUA_IA_MODELO=

# Modelo para analisar relatórios (opcional). Vazio usa o modelo acima.
SCUA_IA_MODELO_ANALISE=
